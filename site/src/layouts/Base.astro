---
interface Props {
  title?: string;
  description?: string;
}

const { title = 'BusyTime – Lights for Busy Times', description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');

const nav = [
  { href: '/guide', label: 'Guide' },
  { href: '/hardware', label: 'Hardware' },
  { href: '/configure', label: 'Configure' },
  { href: '/privacy', label: 'Privacy' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/img/busytime.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
    <title>{title}</title>
    <script is:inline>
      // Analytics only on the production host, so local previews are not counted.
      if (location.hostname === 'busytime.org') {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-TGQCDHSP9R';
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', 'G-TGQCDHSP9R');
      }
    </script>
  </head>
  <body>
    <div class="bar" aria-hidden="true"></div>
    <header>
      <div class="inner">
        <a class="brand" href="/"><img src="/img/busytime.png" alt="" />BusyTime</a>
        <nav aria-label="Primary">
          {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <slot />
    <footer>
      <div class="inner">
        <span>© {new Date().getFullYear()} BusyTime, Inc.</span>
        <span><a href="/privacy">Privacy</a> &nbsp;|&nbsp; <a href="/terms">Terms</a></span>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --text: #1c2430;
    --muted: #5b6573;
    --line: #d9dee5;
    --bg: #ffffff;
    --alt: #f5f7f9;
    --link: #14508c;
    --link-hover: #0e3d6c;
    --status-free: #00ff00;
    --status-free-scheduled: #00a0a0;
    --status-upcoming: #ffff00;
    --status-busy-next: #ff8800;
    --status-busy: #ff0000;
    --status-error: #0000ff;
    --status-off: #000000;
    --success: #1e6b2b;
    --success-bg: #e8f5e9;
    --warning: #8a5300;
    --warning-bg: #fff4e0;
    --error: #b3261e;
    --error-bg: #fdecea;
    --measure: 60ch;
    --page-width: 960px;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 1.0625rem/1.65 system-ui, 'Segoe UI', Roboto, sans-serif;
  }
  a { color: var(--link); }
  a:hover { color: var(--link-hover); }
  .inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .bar {
    height: 4px;
    background: linear-gradient(90deg,
      var(--status-free) 0 25%, var(--status-upcoming) 25% 50%,
      var(--status-busy-next) 50% 75%, var(--status-busy) 75%);
  }
  header { border-bottom: 1px solid var(--line); }
  header .inner { min-height: 64px; flex-wrap: wrap; gap: 8px 24px; }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 1.0625rem;
    color: var(--text);
    text-decoration: none;
  }
  .brand:hover { color: var(--text); }
  .brand img { width: 24px; height: 24px; }
  header nav { display: flex; gap: 24px; }
  header nav a {
    color: var(--text);
    text-decoration: none;
    font-size: 0.9rem;
    padding: 4px 0;
    border-bottom: 2px solid transparent;
  }
  header nav a:hover,
  header nav a[aria-current] { border-bottom-color: var(--text); }
  footer { border-top: 1px solid var(--line); margin-top: 72px; color: var(--muted); font-size: 0.9rem; }
  footer .inner { min-height: 72px; flex-wrap: wrap; gap: 8px 24px; }
  footer a { color: var(--muted); }
  @media (max-width: 700px) {
    header nav { gap: 16px; }
  }
</style>
