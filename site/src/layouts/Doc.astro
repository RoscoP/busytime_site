---
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---
<Base title={title.includes('BusyTime') ? title : `${title} – BusyTime`} description={description}>
  <main class="doc">
    <h1>{title}</h1>
    <div class="prose"><slot /></div>
  </main>
</Base>

<style is:global>
  .doc { max-width: var(--page-width); margin: 0 auto; padding: 48px 24px 0; }
  .doc h1 { font-size: 2.4rem; line-height: 1.2; margin: 0 0 24px; }
  .prose { max-width: 75ch; }
  .prose h2 { font-size: 1.3rem; margin: 48px 0 12px; padding-bottom: 8px; border-bottom: 1px solid var(--line); }
  .prose h3 { font-size: 1.1rem; margin: 32px 0 8px; }
  .prose p { margin: 0 0 16px; }
  .prose ul, .prose ol { padding-left: 24px; margin: 0 0 16px; }
  .prose li { margin-bottom: 8px; }
  .prose a { text-decoration: underline; }
  .prose img { display: block; max-width: min(100%, 640px); height: auto; margin: 12px 0; border: 1px solid var(--line); }
  .prose table { width: 100%; border-collapse: collapse; font-size: 0.9rem; margin: 0 0 16px; }
  .prose th, .prose td { text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--line); }
  .prose th { background: var(--alt); color: var(--muted); font-weight: 600; }
  .prose code { font-family: ui-monospace, Consolas, monospace; font-size: 0.9rem; }
  .prose blockquote { margin: 0 0 16px; padding-left: 16px; border-left: 4px solid var(--line); color: var(--muted); }
  @media (max-width: 700px) { .doc h1 { font-size: 1.6rem; } }
</style>
