---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found – BusyTime">
  <main>
    <h1>Page not found</h1>
    <p>The requested page does not exist. Return to the <a href="/">home page</a> or read the <a href="/guide">setup guide</a>.</p>
  </main>
</Base>

<style>
  main { max-width: var(--page-width); margin: 0 auto; padding: 48px 24px 0; }
  h1 { font-size: 2.4rem; line-height: 1.2; margin: 0 0 24px; }
</style>
