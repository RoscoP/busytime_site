---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';

// Intro copy is edited in src/content/pages/home.md
const entry = await getEntry('pages', 'home');
if (!entry) throw new Error('Missing src/content/pages/home.md');
const { Content } = await render(entry);

const states = [
  { color: 'var(--status-free)', name: 'Free', text: 'No busy events.' },
  { color: 'var(--status-free-scheduled)', name: 'Free, scheduled', text: 'Scheduled event that is marked free (for example, all-day events).' },
  { color: 'var(--status-upcoming)', name: 'Upcoming', text: 'A busy time is coming up.' },
  { color: 'var(--status-busy-next)', name: 'Busy, more to follow', text: 'Currently busy, and another busy time follows.' },
  { color: 'var(--status-busy)', name: 'Busy', text: 'Currently busy.' },
  { color: 'var(--status-error)', name: 'Error', text: 'The device cannot read the calendar. The light pulses between blue and red.' },
  { color: 'var(--status-off)', name: 'Off', text: 'No upcoming busy times, or outside the checking hours.' },
];
---
<Base title="BusyTime – Lights for Busy Times" description={entry.data.description}>
  <main>
    <section class="intro">
      <div>
        <h1>BusyTime</h1>
        <p class="tagline">Lights for Busy Times</p>
        <div class="body"><Content /></div>
        <p class="links"><a class="btn" href="/configure">Configure BusyTime</a> <a href="/guide">Setup guide</a></p>
      </div>
      <img src="/img/busytime.png" alt="BusyTime logo" />
    </section>

    <section>
      <h2>Status colors</h2>
      <table>
        <thead><tr><th>Color</th><th>State</th><th>Meaning</th></tr></thead>
        <tbody>
          {states.map((s) => (
            <tr>
              <td><span class="sw" style={`background:${s.color}`}></span></td>
              <td>{s.name}</td>
              <td>{s.text}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section>
      <h2>Setup</h2>
      <ol>
        <li>Connect BusyTime to a PC or Mac with a USB-C cable. It appears as a removable drive.</li>
        <li>Go to <a href="/configure">Configure</a>, and select your calendars and WiFi network.</li>
        <li>Save and download your `settings.json` file to the BusyTime device drive</li>
        <li>Place the device anywhere with WiFi access. It requires only USB-C power.</li>
      </ol>
    </section>
  </main>
</Base>

<style>
  main { max-width: var(--page-width); margin: 0 auto; padding: 0 24px; }
  .intro { display: grid; grid-template-columns: 1fr 160px; gap: 48px; align-items: start; padding: 48px 0 24px; }
  h1 { font-size: 2.4rem; line-height: 1.2; margin: 0 0 4px; }
  .tagline { font-size: 1.0625rem; color: var(--muted); margin: 0 0 24px; }
  .body :global(p) { margin: 0 0 16px; max-width: var(--measure); }
  .intro img { width: 100%; border: 1px solid var(--line); }
  .links { margin-top: 24px; display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; }
  .btn { background: var(--link); color: var(--bg); padding: 8px 24px; text-decoration: none; border-radius: 3px; font-weight: 600; font-size: 0.9rem; }
  .btn:hover { background: var(--link-hover); color: var(--bg); }
  section { margin-top: 48px; }
  .intro { margin-top: 0; }
  h2 { font-size: 1.3rem; margin: 0 0 12px; padding-bottom: 8px; border-bottom: 1px solid var(--line); }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  th, td { text-align: left; padding: 12px; border-bottom: 1px solid var(--line); }
  th { background: var(--alt); font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
  td:first-child, th:first-child { width: 80px; }
  .sw { display: block; width: 36px; height: 16px; border: 1px solid var(--muted); }
  ol { padding-left: 24px; max-width: 70ch; }
  li { margin-bottom: 8px; }
  @media (max-width: 700px) {
    .intro { grid-template-columns: 1fr; gap: 24px; }
    .intro img { width: 96px; order: -1; }
    td:first-child, th:first-child { width: 56px; }
  }
</style>
