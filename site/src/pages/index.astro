---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';

// Intro copy is edited in src/content/pages/home.md
const entry = await getEntry('pages', 'home');
if (!entry) throw new Error('Missing src/content/pages/home.md');
const { Content } = await render(entry);
---
<Base title="BusyTime – Lights for Busy Times" description={entry.data.description}>
  <main>
    <section class="intro">
      <div>
        <h1>BusyTime</h1>
        <p class="tagline">Lights for Busy Times</p>
      </div>
      <img src="/img/busytime.png" alt="BusyTime logo" />
    </section>

    <section class="about">
      <div class="body"><Content /></div>
      <div class="demo" role="group" aria-label="BusyTime in action">
        <img src="/img/BusyTimeDemo.webp" width="1414" height="540" alt="Pyramid light changing color as the calendar events shown beside it start and end" />
        <p>The pyramid light changes color as your day unfolds.</p>
        <p>Colors follow the events on your calendar.</p>
      </div>
      <p class="links"><a class="btn" href="/configure">Configure BusyTime</a> <a href="/guide">Setup guide</a></p>
    </section>
  </main>
</Base>

<style>
  main { max-width: var(--page-width); margin: 0 auto; padding: 0 24px; }
  .intro { display: grid; grid-template-columns: 1fr 96px; gap: 24px; align-items: center; padding: 40px 0 0; }
  h1 { font-size: 2.4rem; line-height: 1.2; margin: 0 0 4px; }
  .tagline { font-size: 1.0625rem; color: var(--muted); margin: 0; }
  .body :global(p) { margin: 0 0 16px; max-width: var(--measure); }
  .intro img { width: 100%; border: 1px solid var(--line); }
  .links { margin-top: 24px; display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; }
  .btn { background: var(--link); color: var(--bg); padding: 8px 24px; text-decoration: none; border-radius: 3px; font-weight: 600; font-size: 0.9rem; }
  .btn:hover { background: var(--link-hover); color: var(--bg); }
  .demo { display: grid; grid-template-columns: 720fr 694fr; column-gap: 0; margin: 8px 0 24px; max-width: 800px; order: 2; }
  .about { margin-top: 32px; display: flex; flex-direction: column; }
  /* Flatten the markdown wrapper so the demo can sit between its paragraphs */
  .body { display: contents; }
  .body :global(p:first-child) { order: 1; }
  .body :global(p:not(:first-child)) { order: 3; }
  .links { order: 4; }
  /* One animated WebP holds both animations so they share a single clock */
  .demo img { grid-column: 1 / -1; display: block; width: 100%; height: auto; }
  .demo p { margin: 8px 12px 0 0; font-size: 0.85rem; color: var(--muted); }
  @media (max-width: 700px) {
    .intro { grid-template-columns: 1fr; gap: 24px; }
    .intro img { width: 96px; order: -1; }
  }
</style>
