---
import Base from '../layouts/Base.astro';
---
<Base title="Configure BusyTime – BusyTime" description="Configure your BusyTime device.">
  <main>
    <p class="note"><a href="/ConfigureBusyTime.html">Open the configuration tool in a full window</a></p>
    <iframe src="/ConfigureBusyTime.html" title="BusyTime configuration"></iframe>
  </main>
</Base>

<style>
  main { max-width: var(--page-width); margin: 0 auto; padding: 24px 24px 0; }
  .note { margin: 0 0 12px; font-size: 0.9rem; }
  iframe { display: block; width: 100%; height: 80vh; min-height: 640px; border: 1px solid var(--line); }
</style>
