---
import Base from '../layouts/Base.astro';
---
<Base title="Configure BusyTime – BusyTime" description="Create or edit the settings file for your BusyTime device.">
  <Fragment slot="head">
    <!-- Icon font for the configurator, loaded on this page only. display=block hides icon names until it arrives. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block" />
    <link rel="stylesheet" href="/configure/app.css" />
  </Fragment>
  <main>
    <h1>Configure BusyTime</h1>
    <p class="intro">Create the <code>settings.json</code> file for a BusyTime device, or edit an existing one. The <a href="/guide">setup guide</a> explains where to put the file.</p>
    <div id="busytime-app">
      <noscript><p>The configuration tool requires JavaScript.</p></noscript>
    </div>
  </main>
  <!-- Built from the busytime repo (src/webapp) and copied here by Deploy-Webapp.ps1. -->
  <script is:inline src="/configure/app.js" defer></script>
</Base>

<style>
  main { max-width: var(--page-width); margin: 0 auto; padding: 48px 24px 0; }
  h1 { font-size: 2.4rem; line-height: 1.2; margin: 0 0 24px; }
  .intro { max-width: var(--measure); margin: 0 0 32px; }
  code { font-family: ui-monospace, Consolas, monospace; font-size: 0.9rem; }
  @media (max-width: 700px) { h1 { font-size: 1.6rem; } }
</style>
